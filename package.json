{
  "name": "@yolo-rs/yolo-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo yolo-stack : Rust (Cargo) + Bun. Piliers yolo-*, harnais de benchmark et applications (Shenron).",
  "license": "Apache-2.0",
  "author": "aphrody-dev <contact@aphrody.com>",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "pillars/*/packages/*",
    "apps/*/packages/*",
    "packages/*",
    "apps/showcase-tanstack",
    "bench"
  ],
  "scripts": {
    "check": "bun run typecheck && cargo check --workspace",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "bench": "bun run bench/bench.ts",
    "bench:baseline": "bun run bench/bench.ts --target baseline",
    "cargo:check": "cargo check --workspace",
    "cargo:test": "cargo test --workspace",
    "next": "bun packages/yolo-next/src/cli.ts",
    "next:analyze": "cargo run -p yolo-next -- analyze",
    "next:migrate": "cargo run -p yolo-next -- migrate",
    "next:test": "cargo test -p yolo-next && cd packages/yolo-next && bun test",
    "fusion": "bun scripts/fusion.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "bun-types": "1.4.4",
    "typescript": "5.9.3"
  }
}
